#!/bin/sh
# charon updown script for the "ims" CHILD_SA (specs/012-strongswan-epdg).
# Installs/removes the carrier-assigned inner address on the pre-created
# XFRM interface living inside network namespace "$NETNS" — the interface
# and namespace themselves are created once by docker/entrypoint.sh and
# never touched here (research.md item 3: this is what lets rekeys and
# reconnects swap addresses without ever deleting the namespace, FR-005).
#
# The osmocom wiki's own ims.updown only handles the "-v6" verbs (its
# example carrier only assigned IPv6). This one handles both address
# families, since carriers here have been observed assigning IPv4-only,
# IPv6-only, or both (docs/vowifi-epdg-research-notes.md).
#
# NETNS/TUN_IFACE default to the same values docker/entrypoint.sh uses;
# both are inherited from the container environment set before charon
# starts, kept overridable here (not hardcoded) per FR-013.
set -u

NETNS="${NETNS:-ims}"
TUN_IFACE="${STRONGSWAN_TUN_IFACE:-tun23}"

log() { echo "[ims.updown] $*" >&2; }

# charon invokes this script with no positional arguments at all (only
# PLUTO_* env vars) — a bare "$1" under `set -u` aborts with "1: parameter
# not set" (confirmed live: this crashed on every real up-client-v6 event
# until fixed). "${1:-}" tolerates that; the trailing ":*" glob in each
# case arm never needed a real $1 value anyway.
# Reinstall the family's default route through the tunnel.
#
# This belongs here, next to the address, because of a kernel behaviour that
# caused a 6-hour outage on 2026-08-19: removing the *last* address of a family
# from an interface also deletes that interface's `default dev <iface> scope
# link` route. So every `down-client` below silently destroys the route, and
# before this the only thing that ever installed it was `ensure_epdg_interface`
# at establish time. A transient WAN outage was therefore unrecoverable: the
# router rebooted, charon tore the CHILD_SA down (`addr del` -> route gone),
# and when the internet came back the reconnect restored the *address* and
# nothing restored the route. Every SIP connect then got ENETUNREACH forever,
# while `swanctl --list-sas` reported a perfectly healthy tunnel.
#
# Doing it on the up path makes it event-driven rather than ordering-dependent:
# whenever an address exists, so does its route, regardless of what the
# supervisor happens to be doing. `replace` is idempotent, so a rekey that does
# not disturb the route is a no-op.
install_default_route() {
    _fam="$1" # "" for IPv4, "-6" for IPv6
    # shellcheck disable=SC2086 # $_fam is a deliberate 0-or-1 word flag
    if ip netns exec "$NETNS" ip $_fam route replace default dev "$TUN_IFACE" 2>/dev/null; then
        log "installed default route${_fam:+ (IPv6)} via $TUN_IFACE in netns $NETNS"
    else
        # Never silent. The Rust side's own attempt at this discarded its
        # result, which is why 202 recovery attempts left no record of why the
        # data path never came back.
        log "WARNING: could not install default route${_fam:+ (IPv6)} via $TUN_IFACE in netns $NETNS"
    fi
    unset _fam
}

case "$PLUTO_VERB:${1:-}" in
up-client:*)
    if [ -z "${PLUTO_MY_CLIENT:-}" ]; then
        log "no PLUTO_MY_CLIENT set on $PLUTO_VERB; nothing to install"
        exit 0
    fi
    log "installing $PLUTO_MY_CLIENT on $TUN_IFACE in netns $NETNS"
    ip netns exec "$NETNS" ip addr add "$PLUTO_MY_CLIENT" dev "$TUN_IFACE" 2>/dev/null || true
    install_default_route ""
    ;;
up-client-v6:*)
    if [ -z "${PLUTO_MY_CLIENT:-}" ]; then
        log "no PLUTO_MY_CLIENT set on $PLUTO_VERB; nothing to install"
        exit 0
    fi
    log "installing $PLUTO_MY_CLIENT on $TUN_IFACE in netns $NETNS"
    ip netns exec "$NETNS" ip addr add "$PLUTO_MY_CLIENT" dev "$TUN_IFACE" 2>/dev/null || true
    install_default_route "-6"
    ;;
down-client:* | down-client-v6:*)
    if [ -z "${PLUTO_MY_CLIENT:-}" ]; then
        log "no PLUTO_MY_CLIENT set on $PLUTO_VERB; nothing to remove"
        exit 0
    fi
    log "removing $PLUTO_MY_CLIENT from $TUN_IFACE in netns $NETNS"
    ip netns exec "$NETNS" ip addr del "$PLUTO_MY_CLIENT" dev "$TUN_IFACE" 2>/dev/null || true
    ;;
*)
    log "unhandled verb '$PLUTO_VERB' (arg: '${1:-}') — ignoring"
    ;;
esac

exit 0
