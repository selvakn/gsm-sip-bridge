+CALLBACK(dpd, vici_message_t*,
+	private_vici_control_t *this, char *name, u_int id, vici_message_t *request)
+{
+	char *ike, errbuf[128];
+	ike_sa_t *ike_sa;
+	ike_sa_state_t state;
+	vici_builder_t *builder;
+	char *errmsg = NULL;
+	u_int ike_id = 0;
+
+	ike = request->get_str(request, NULL, "ike");
+	if (!ike)
+	{
+		return send_reply(this, "missing IKE_SA name");
+	}
+	DBG1(DBG_CFG, "vici dpd IKE_SA '%s'", ike);
+
+	ike_sa = charon->ike_sa_manager->checkout_by_name(
+										charon->ike_sa_manager, ike, FALSE);
+	if (!ike_sa)
+	{
+		snprintf(errbuf, sizeof(errbuf), "no IKE_SA named %s", ike);
+		errmsg = errbuf;
+	}
+	else
+	{
+		state = ike_sa->get_state(ike_sa);
+		if (state != IKE_ESTABLISHED)
+		{
+			snprintf(errbuf, sizeof(errbuf), "IKE_SA %s is %s", ike,
+					 enum_to_name(ike_sa_state_names, state));
+			errmsg = errbuf;
+			charon->ike_sa_manager->checkin(charon->ike_sa_manager, ike_sa);
+		}
+		else
+		{
+			ike_id = ike_sa->get_unique_id(ike_sa);
+			ike_sa->queue_task(ike_sa, &ike_dpd_create(TRUE)->task);
+			if (ike_sa->initiate(ike_sa, NULL, 0, NULL, NULL) == DESTROY_ME)
+			{
+				charon->ike_sa_manager->checkin_and_destroy(
+										charon->ike_sa_manager, ike_sa);
+				errmsg = "IKE_SA was destroyed while starting the DPD";
+			}
+			else
+			{
+				charon->ike_sa_manager->checkin(charon->ike_sa_manager, ike_sa);
+			}
+		}
+	}
+
+	builder = vici_builder_create();
+	builder->add_kv(builder, "success", errmsg ? "no" : "yes");
+	if (errmsg)
+	{
+		builder->add_kv(builder, "errmsg", "%s", errmsg);
+	}
+	else
+	{
+		builder->add_kv(builder, "ike-id", "%u", ike_id);
+	}
+	return builder->finalize(builder);
+}
