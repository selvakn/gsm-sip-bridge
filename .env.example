# Secrets only. All other configuration (VoWiFi/ePDG tunnel engine, MCC/MNC,
# metrics port, etc.) lives in config.toml — see config.toml.example's
# [vowifi] section and docs/configuration.md. config.toml may reference a
# secret from here via "env:VAR_NAME" on any string field (e.g. SIP
# credentials, the Discord webhook URL below).

# SIP credentials
SIP_PASSWORD=changeme

# Discord webhook for SMS forwarding (leave empty to disable)
DISCORD_WEBHOOK_URL=

# Grafana admin password (docker-compose only — the grafana/grafana image
# has no knowledge of our config.toml, so this one can't move there)
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Cellular-internet sidecar (OPTIONAL — specs/032-cellular-internet-sidecar).
# Only used when you run with docker/docker-compose.cellular-internet.yml, i.e.
# a deployment whose internet comes from the same card that carries VoWiFi.
# Not secrets, but they live here because the sidecar is configured via env
# (like GRAFANA_ADMIN_PASSWORD above). See docs/ec20-internet-plus-vowifi.md.
# ---------------------------------------------------------------------------
# Required: the carrier's INTERNET apn (NOT an IMS apn). No default is dialed.
INTERNET_APN=
# QMI control device (keeps the modem's AT port free for the bridge's AT+CSIM).
INTERNET_QMI_DEV=/dev/cdc-wdm0
# DNS reachability probe that defines "internet is ready". Override the resolver
# if your carrier/APN blocks the default.
INTERNET_PROBE_HOST=one.one.one.one
INTERNET_PROBE_RESOLVER=1.1.1.1
